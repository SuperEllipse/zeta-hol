# Copy this file to connect-cai.env and fill in your values:
#   cp connect-cai.env.example connect-cai.env
#
# connect-cai.env is gitignored locally — never commit real API keys.

# Cloudera AI workbench URL (from your browser address bar after opening zeta1-workbench1)
CAI_DOMAIN="https://ml-810351e3-a81.zeta1-cd.z30z-14kp.cloudera.site"

# Your Cloudera AI username (from your workshop credentials)
CAI_USERNAME="your-username"

# API key from User Settings → Keys & Access → API Keys
# Do NOT use a Legacy API key — create a new API key in Cloudera AI
API_KEY="your-api-key"

# Project slug — MUST be <your-username>/teamXX-project (full slug from the browser URL)
# Your team project has been pre-created for you. XX is your assigned team number.
# Open your assigned project in the Workbench and copy the slug from the URL bar.
# Example: PROJECT_NAME="your-username/team07-project"
PROJECT_NAME="your-username/teamXX-project"

# --- Optional overrides (defaults shown) ---

# Python runtime version to match (PBJ Workbench editor)
# PYTHON_VERSION="3.12"

# Session resources (cdswctl defaults: cpu=2, memory=4, gpu=0)
# SESSION_CPU="2"
# SESSION_MEMORY="4"
# SESSION_GPU="0"

# Set to true to select an Nvidia GPU runtime edition instead of Standard
# USE_GPU="false"

# Set to true to attach a Spark runtime add-on (off by default)
# USE_SPARK="false"

# Spark version to match when USE_SPARK=true (first matching add-on is used)
# SPARK_VERSION="3.4"

# Override auto-detected runtime ID (leave unset for automatic selection)
# RUNTIME_ID="664"

# Reuse a specific session instead of auto-detecting (leave unset normally)
# SESSION_ID="abc123sessionid"

# Fixed local SSH port — script picks the next free port if this one is in use
# SSH_LOCAL_PORT="3735"
# SSH_HOST_ALIAS="cai-workbench"
# SSH_IDENTITY_FILE="~/.ssh/cai"
